# AI Service (FastAPI)
AI_SERVICE_PORT=5000
ENV=development

# 브라우저에서 직접 호출할 수 있는 출처(origin) 목록. 쉼표로 구분한다.
# 비워두면 CORS 미들웨어를 아예 달지 않는다 — 게이트웨이(:4000)가 서버끼리
# 호출하는 정상 경로에는 CORS 가 필요 없기 때문이다.
# 기본값은 프론트 개발 서버(Vite)다. `*` 는 쓰지 말 것 — 요청 본문에
# 선하증권·신용장 내용이 실린다.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 업로드 파일 1건의 최대 크기(byte). 기본 20MB. 이 크기를 넘는 파일은
# 서버가 실제로 읽기 전에 413 으로 거절한다 — 크기 제한이 없으면 큰 파일을
# 계속 올리는 것만으로 서버 메모리를 고갈시킬 수 있다.
MAX_UPLOAD_BYTES=20971520

# OCR (PaddleOCR)
OCR_LANG=korean
OCR_USE_GPU=false

# OCR 에 넣는 이미지의 최대 너비(px). 추론 시간이 화소 수에 비례하므로,
# 상한이 없으면 폰으로 찍은 사진 한 장에 1분 가까이 걸린다.
#
# 기본값 1654 는 구역 좌표가 교정된 해상도다(`preprocessor.STANDARD_WIDTH`).
# **축소가 실물 스캔의 작은 글씨를 뭉개는지는 아직 검증되지 않았다** — 지금
# 근거는 합성 이미지 한 장뿐이고 거기서는 해상도를 바꿔도 인식 박스 수가
# 같았다. 즉 속도만 구분됐고 정확도는 구분되지 않았다.
#
# 0 으로 두면 축소하지 않는다.
OCR_MAX_WIDTH=1654

# ML 이상거래탐지 모델
XGBOOST_MODEL_PATH=./mlModel/artifacts/defect_model.json

# LLM (F4 리포트 산문 요약 / F1 구조화 추출)
# LLM_PROVIDER 를 비우거나 template 로 두면 외부 호출 없이 규칙 기반 요약을 쓴다.
# 키가 없거나 changeme 이면 자동으로 템플릿으로 떨어지므로, 키 없이도 리포트는 나온다.
LLM_PROVIDER=template
GEMINI_API_KEY=changeme
# F1 구조화 추출을 켠다. 파서가 비운 **핵심 필드만** LLM 으로 채우며,
# 채운 값은 provenance 가 llm 이고 신뢰도가 임계값 아래라 초안 편집기가
# 반드시 사람 확인을 요구한다.
# 기본이 꺼짐인 이유는 외부 API 호출이기 때문이다 — 켜면 추출 경로가
# 네트워크·요금·지연에 묶인다. 켜는 것은 명시적 결정이어야 한다.
LLM_STRUCTURED_EXTRACT=false
# 버전을 고정한다. `gemini-flash-latest` 같은 별칭은 밑에서 모델이 바뀌어
# 같은 서류에 다른 요약이 나와도 원인을 알 수 없다.
#
# 바꿀 때는 목록 조회가 아니라 **실제 호출로** 확인할 것 — `gemini-2.5-flash`
# 는 list_models() 목록에 아직 보이지만 호출하면 404 로 막힌다.
LLM_MODEL=gemini-3.7-flash
LLM_MAX_TOKENS=600
LLM_TIMEOUT=20

# F4 리포트 공유 링크 서명 키
# 설정하지 않으면 프로세스마다 임시 키를 만들어 쓴다 — 서버를 재시작하면
# 이미 발급한 공유 링크가 전부 무효가 된다. 시연·배포에서는 반드시 채울 것.
# 고정 기본값을 두지 않는 이유는 소스를 읽은 누구나 토큰을 위조할 수 있기 때문이다.
REPORT_SHARE_SECRET=changeme-report-share-secret

# F2 표준 용어 교정 — ⑤단계(LLM 후보 선정)를 켠다.
# 기본이 꺼짐인 이유는 외부 API 호출이기 때문이다. 꺼 두면 유사도 후보를
# 사용자에게 나열해 직접 고르게 한다 — 제안이 사라지는 것이 아니라
# 자동 선정만 사라진다.
TERMS_LLM_SELECT=false
# 판정에 쓸 표준 사전 버전. 비우면 effective_date 가 가장 최신인 것을 쓴다.
TERMS_GLOSSARY_VERSION=std-2026.3
# ⑤단계 한 번에 묶어 물을 항목 수. 늘리면 선적 10초 예산이 위험해진다.
TERMS_LLM_MAX_ITEMS=20
# ⑤단계 타임아웃(초). LLM_TIMEOUT(20)을 그대로 쓰면 선적 10초 예산을 넘긴다.
TERMS_LLM_TIMEOUT=8

# F6 통관·운송 현실 대조 — 울산항만공사 항만 내 선박 운항정보
# fixture 는 패키지에 든 샘플(reality/fixtures/ulsan_vts_2025.json)을 쓴다.
# ulsan 으로 바꾸면 실 API 를 호출한다 — 키 없이 바꾸면 /reality/check 가
# 503 을 낸다(빈 결과로 조용히 떨어지면 '경보 없음'으로 읽히기 때문).
REALITY_EVENT_SOURCE=fixture
# fixture 소스가 읽을 파일 경로. 비우면 패키지 내 기본 샘플을 쓴다.
REALITY_FIXTURE_PATH=
# 공공데이터포털 "울산항만공사_항만 내 선박 운항정보" 엔드포인트.
# 오퍼레이션명(getVtsBaseVslNvgtInfo)까지 붙여야 한다 — 서비스 루트만 두면
# NO_OPENAPI_SERVICE_ERROR(reasonCode 12)가 난다.
# 예: https://apis.data.go.kr/B551938/VslNvgtInfoService/getVtsBaseVslNvgtInfo
ULSAN_VTS_BASE_URL=
# 발급받은 서비스키. changeme 그대로면 ulsan 소스가 즉시 오류를 낸다 —
# 빈 결과를 정상 응답처럼 돌려주지 않기 위해서다.
ULSAN_VTS_SERVICE_KEY=changeme
# 실 API 호출 타임아웃(초).
ULSAN_VTS_TIMEOUT=8
