{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/smart-ebl/prod",
        "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/smart-ebl/prod/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringValues",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-northeast-2:<ACCOUNT_ID>:key/<KMS_KEY_ID>",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        }
      }
    }
  ]
}
