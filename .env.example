# 이 파일을 `.env` 로 복사한 뒤 실제 값을 채우세요. (`cp .env.example .env`)
# `.env` 는 .gitignore 대상이며 절대 커밋하지 않습니다.

# PostgreSQL (docker compose)
POSTGRES_DB=smart_ebl
POSTGRES_USER=smart_ebl
# 필수값. 비어 있으면 `docker compose up` 이 실패합니다.
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
# 호스트에서 포트를 노출할 인터페이스. 운영(EC2)에서는 반드시 127.0.0.1 로 두세요.
POSTGRES_BIND_HOST=127.0.0.1
TZ=Asia/Seoul

DATABASE_URL=postgresql://smart_ebl:changeme@localhost:5432/smart_ebl

# 배포 환경의 공개 접속 주소. 로컬 개발은 기본값(localhost)을 그대로 두면 되지만,
# EC2/도메인에서 시연할 때는 반드시 실제 접속 주소로 바꿔야 한다 — 안 바꾸면
# 원격 브라우저가 CORS 차단(PUBLIC_ORIGIN) 또는 localhost 호출 실패
# (AI_SERVICE_PUBLIC_URL)로 전 기능이 멈춘다.
# 예: PUBLIC_ORIGIN=http://ec2-1-2-3-4.compute.amazonaws.com:8080
#     AI_SERVICE_PUBLIC_URL=http://ec2-1-2-3-4.compute.amazonaws.com:5050
PUBLIC_ORIGIN=http://localhost:8080
AI_SERVICE_PUBLIC_URL=http://localhost:5050

# AWS
# 액세스 키는 두지 않습니다. EC2 인스턴스 프로파일(IAM 역할)이 임시 자격증명을
# 자동 발급하므로 서버에 장기 자격증명을 저장할 필요가 없습니다.
# 설정: infra/aws/iam/README.md
AWS_REGION=ap-northeast-2
EC2_HOST=changeme.compute.amazonaws.com
EC2_SSH_KEY_PATH=./keys/ec2-key.pem

# Docker
DOCKERHUB_USERNAME=changeme
DOCKERHUB_TOKEN=changeme

# CI/CD (Github Actions / Jenkins)
GITHUB_TOKEN=changeme
JENKINS_URL=https://jenkins.example.com
JENKINS_API_TOKEN=changeme

# Cloudflare
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ZONE_ID=changeme
DOMAIN_NAME=example.com

# Google Gemini (F3 LLM 피처 — ai/defect_model, 배포 안 되는 별도 트리)
# aistudio.google.com/apikey 에서 발급. gemini-3.7-flash 는 무료 등급입니다.
# 비워 두면 LLM 피처는 오프라인 휴리스틱(DEFECT_MODEL_LLM_FEATURE_BACKEND=offline)으로 동작합니다.
GEMINI_API_KEY=
# 실제 Gemini 호출을 켤 때만 gemini 로 바꾸세요. 기본값 offline 은 네트워크를 쓰지 않습니다.
DEFECT_MODEL_LLM_FEATURE_BACKEND=offline

# ── backend/aiService (docker compose의 ai-service 서비스) ──────────
# 이 섹션이 비어 있으면 아래 값들이 컨테이너에 전달되지 않고, aiService는
# 조용히 fixture/오프라인 기본값으로 떨어진다(운영에서는 절대 원하는 동작이
# 아니다) — 값은 backend/aiService/.env.example 에 더 자세히 설명되어 있다.
ENV=production
# 서비스끼리(게이트웨이 ↔ aiService) 아직 인증이 없어서 생긴 임시 방편.
# 프론트 빌드(VITE_AI_INTERNAL_TOKEN)에도 반드시 같은 값을 넣어야 한다.
# 진짜 비밀은 아니다 — 빌드된 JS 번들에 그대로 들어간다.
AI_INTERNAL_TOKEN=changeme-internal-token
# F6 통관·운송 현실 대조. ulsan 로 두면 아래 두 값이 반드시 있어야 한다 —
# 없으면 기동 로그에 경고가 뜨고(ENV=production 인데 fixture 로 떨어지면
# 서버가 뜨지 않는다), 매칭은 항상 "특정 못 함"으로 빠진다.
REALITY_EVENT_SOURCE=ulsan
ULSAN_VTS_BASE_URL=
ULSAN_VTS_SERVICE_KEY=
# F4 리포트 공유 링크 서명 키. 비워 두면 프로세스마다 임시 키를 써서
# 재시작할 때마다 이미 발급된 공유 링크가 전부 무효가 된다.
REPORT_SHARE_SECRET=
# F2/F4 LLM 기능. 비워 두면 LLM 없이 동작한다(캐스케이드 자동 선정만 빠짐).
LLM_PROVIDER=
# 위 ai/defect_model 의 GEMINI_API_KEY 와는 별개 값이다(다른 서비스,
# 다른 사용량 — 이름을 겹치게 두면 한쪽 배포가 다른 쪽 쿼터를 같이 쓴다).
AI_SERVICE_GEMINI_API_KEY=
# F2 ⑤단계(LLM 후보 자동 선정). 꺼 두면 유사도 후보를 사람에게 나열만 한다 —
# 제안이 사라지는 것이 아니라 자동 선정만 빠진다.
TERMS_LLM_SELECT=false
# F1 구조화 추출. 파서가 비운 **핵심 필드만** LLM 으로 채운다.
# 기본이 꺼짐인 이유는 외부 API 호출이라 추출 경로가 네트워크·요금·지연에
# 묶이기 때문이다 — 켜는 것은 명시적 결정이어야 한다.
LLM_STRUCTURED_EXTRACT=false
# 모델 버전 고정. 비우면 코드 기본값을 쓴다. `-latest` 류 별칭은 밑에서
# 모델이 바뀌어도 알 수 없으므로 시연·배포에서는 명시하는 편이 낫다.
LLM_MODEL=
